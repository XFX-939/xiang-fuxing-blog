# Copy to .env.local for local development; never commit real credentials.
BLOG_ADMIN_ORIGIN=http://localhost:3000
# Generate with npm run --silent admin:hash (password is read from stdin).
# Next.js dotenv expands $ even inside quotes. Escape each $ as \$ here.
BLOG_ADMIN_PASSWORD_HASH='scrypt\$REPLACE_WITH_32_HEX_SALT\$REPLACE_WITH_128_HEX_KEY'
# Generate a random value: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
BLOG_ADMIN_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Development defaults to .local-data/blog. Production requires an absolute
# persistent directory OUTSIDE the checkout, releases/, and current/.
# BLOG_CONTENT_DIR=/var/lib/xiang-fuxing-blog/content
